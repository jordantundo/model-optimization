import pandas as pd
import matplotlib.pyplot as plt
from sklearn.svm import SVC
from sklearn.model_selection import GridSearchCV
from sklearn.datasets import load_breast_cancer

# Load data
data = load_breast_cancer()
X, y = data.data, data.target

# Parameter grid
param_grid = {
    'C': [0.1, 1, 10, 100],
    'gamma': ['scale', 'auto', 0.01, 0.1],
    'kernel': ['linear', 'rbf']
}

# GridSearchCV
grid = GridSearchCV(SVC(), param_grid, cv=5, verbose=2)
grid.fit(X, y)

# Plot results (heatmap for C vs. gamma)
results = pd.DataFrame(grid.cv_results_)
scores = results.pivot_table(index='param_C', columns='param_gamma', values='mean_test_score')

plt.figure(figsize=(10, 6))
plt.title("GridSearchCV Results (SVM)")
plt.imshow(scores, cmap='viridis')
plt.colorbar()
plt.xticks(range(len(scores.columns)), scores.columns, rotation=45)
plt.yticks(range(len(scores.index)), scores.index)
plt.xlabel('Gamma')
plt.ylabel('C')
plt.show()
